# Copy to .env.local. Never commit the file containing real values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virtufit
JWT_SECRET=
JWT_ADMIN_SECRET=
DECART_API_KEY=
# Free public launch. Only literal true enables new payment initiation.
PAYMENTS_ENABLED=false
DECART_ENABLED=true
DECART_DAILY_REQUEST_LIMIT=50
DECART_VISITOR_DAILY_REQUEST_LIMIT=5
DECART_NETWORK_DAILY_REQUEST_LIMIT=10
DECART_CONCURRENT_LIMIT=2
DECART_DAILY_UNIT_LIMIT=100
# Optional account email
RESEND_API_KEY=
EMAIL_FROM=VirtuFit <noreply@virtufit.xyz>
# Existing integrations/billing: optional when payments are off
REPLICATE_API_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
