    "fix-topup-amounts": "npx tsx scripts/fix-topup-amounts.ts",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "test:load": "npx tsx tests/loadTest.ts",
    "test:concurrency": "npx tsx tests/loadTest.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@react-three/fiber": "^9.5.0",
