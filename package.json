{
  "name": "virtufit",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "npx tsx src/workers/generation-worker.ts",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "seed": "npx prisma db push && npx tsx prisma/seed.ts",
    "delete-all-users": "npx tsx scripts/delete-all-users.ts",
    "fix-topup-amounts": "npx tsx scripts/fix-topup-amounts.ts",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "test:load": "npx tsx tests/loadTest.ts",
    "test:concurrency": "npx tsx tests/loadTest.ts",
    "test:try-on": "node --import tsx --test tests/try-on/*.test.ts tests/try-on/*.test.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@decartai/sdk": "0.2.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-three/fiber": "^9.8.2",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "cloudinary": "^2.9.0",
    "ioredis": "^5.10.0",
    "jose": "^6.2.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "next": "^16.4.2",
    "pg": "^8.20.0",
    "prisma": "7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "replicate": "^1.4.0",
    "resend": "^6.9.3",
    "sharp": "^0.35.5",
    "three": "^0.183.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "@types/zxcvbn": "^4.4.5",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
